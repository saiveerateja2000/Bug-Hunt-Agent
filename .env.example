# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=replace-with-random-secret
LOCAL_AUTH_TOKEN=replace-with-local-token

# Database
POSTGRES_USER=bughunt
POSTGRES_PASSWORD=bughunt
POSTGRES_DB=bughunt
DATABASE_URL=******postgres:5432/bughunt

# Model provider
MODEL_PROVIDER=mock
MODEL_API_KEY=replace-with-model-key

# Research safety defaults
RESEARCH_MODE=passive
APPROVAL_MODE=human_required
AUTO_REPORT_SUBMISSION=false
ALLOW_DESTRUCTIVE_TESTING=false
DEFAULT_RATE_LIMIT_RPS=1
MAX_CAMPAIGN_DURATION_MINUTES=60
MAX_TOTAL_REQUESTS=200
MAX_WORKERS=1

# Paths
EVIDENCE_DIR=/data/evidence
REPORTS_DIR=/data/reports
LOG_DIR=/data/logs
BACKUP_DIR=/data/backups

# Tooling
TOOL_PLAYWRIGHT_ENABLED=true
TOOL_HTTP_PROBE_ENABLED=true

# Logging
LOG_LEVEL=INFO
